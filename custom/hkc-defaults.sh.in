#!/bin/sh

set -eu

WIFI_PASSWORD='__WIFI_PASSWORD__'

if [ -z "$WIFI_PASSWORD" ]; then
	echo "HKC firmware: Wi-Fi password was not injected" >&2
	exit 1
fi

# Generate the original device radio sections when they do not exist, then
# change only the two requested SSIDs and their shared private password.
if ! uci -q show wireless | grep -q '=wifi-device$'; then
	wifi config
fi

radio_count=0
for radio in $(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
	band="$(uci -q get "wireless.${radio}.band" || true)"

	case "$band" in
		2g) ssid='HKC' ;;
		5g) ssid='HKC-5G' ;;
		*)
			echo "HKC firmware: unsupported radio band on ${radio}" >&2
			exit 1
			;;
	esac
	radio_count=$((radio_count + 1))

	uci -q set "wireless.${radio}.disabled=0"
	iface="$(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)\.device='${radio}'$/\1/p" | head -n 1)"
	if [ -z "$iface" ]; then
		iface="default_${radio}"
		uci -q set "wireless.${iface}=wifi-iface"
		uci -q set "wireless.${iface}.device=${radio}"
		uci -q set "wireless.${iface}.network=lan"
		uci -q set "wireless.${iface}.mode=ap"
	fi
	uci -q set "wireless.${iface}.ssid=${ssid}"
	uci -q set "wireless.${iface}.encryption=sae-mixed"
	uci -q set "wireless.${iface}.key=${WIFI_PASSWORD}"
	uci -q set "wireless.${iface}.ieee80211w=1"
done

if [ "$radio_count" -ne 2 ]; then
	echo "HKC firmware: expected two wireless radios, found ${radio_count}" >&2
	exit 1
fi
uci -q commit wireless

# Keep all SSR Plus settings and service behavior upstream. Only append the
# requested domains to the plugin's original blacklist.
forced_domains='/usr/share/hkc/forced-proxy-domains.list'
blacklist='/etc/ssrplus/black.list'
mkdir -p /etc/ssrplus
touch "$blacklist"
if [ ! -r "$forced_domains" ]; then
	echo "HKC firmware: forced proxy domain list is missing" >&2
	exit 1
fi

while IFS= read -r domain || [ -n "$domain" ]; do
	case "$domain" in
		''|'#'*) continue ;;
	esac
	grep -Fqx "$domain" "$blacklist" || printf '%s\n' "$domain" >>"$blacklist"
done <"$forced_domains"

exit 0
