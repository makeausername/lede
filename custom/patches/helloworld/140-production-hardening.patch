index 0000000000000000000000000000000000000000..a3719da25261638d7e21b14b7c453761ec82e36b
--- /dev/null
+++ b/luci-app-ssr-plus/luasrc/view/shadowsocksr/classic_subscribe_commit.htm
@@ -0,0 +1,49 @@
+<script type="text/javascript">
+//<![CDATA[
+(function() {
+	function bindClassicSubscribeField() {
+		var pending = document.querySelector(
+			'.cbi-dynlist .add-item > input[id$="._classic_subscribe_urls"]'
+		);
+		if (!pending || pending.dataset.ssrSubmitBound === '1') {
+			return !!pending;
+		}
+
+		var fieldName = (pending.id || '').replace(/^widget\./, '');
+		if (!fieldName) {
+			return false;
+		}
+
+		/*
+		 * LuCI DynamicList intentionally leaves the pending row unnamed until
+		 * the + button is clicked. Give it the real CBI name so a direct Save
+		 * submits the visible value too. An empty pending row also acts as an
+		 * explicit presence marker when all committed rows are removed.
+		 */
+		pending.name = fieldName;
+		pending.dataset.ssrSubmitBound = '1';
+
+		var marker = document.createElement('input');
+		marker.type = 'hidden';
+		marker.name = fieldName + '.__present';
+		marker.value = '1';
+		pending.form.appendChild(marker);
+		return true;
+	}
+
+	var attempts = 0;
+	function bindWithRetry() {
+		if (bindClassicSubscribeField() || attempts++ >= 30) {
+			return;
+		}
+		window.setTimeout(bindWithRetry, 100);
+	}
+
+	if (document.readyState === 'loading') {
+		document.addEventListener('DOMContentLoaded', bindWithRetry);
+	} else {
+		bindWithRetry();
+	}
+})();
+//]]>
+</script>
