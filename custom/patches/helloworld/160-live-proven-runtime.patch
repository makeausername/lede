diff --git a/luci-app-ssr-plus/root/etc/init.d/shadowsocksr b/luci-app-ssr-plus/root/etc/init.d/shadowsocksr
--- a/luci-app-ssr-plus/root/etc/init.d/shadowsocksr
+++ b/luci-app-ssr-plus/root/etc/init.d/shadowsocksr
@@ -85,4 +85,5 @@
-EXTRA_COMMANDS='reset clash_cache failopen'
-EXTRA_HELP="        reset        Reset to default settings
-        clash_cache  Download and cache Clash node config
-        failopen     Disable proxy interception and restore direct networking"
+EXTRA_COMMANDS='reset clash_cache failopen running'
+EXTRA_HELP="        reset        Reset to default settings
+        clash_cache  Download and cache Clash node config
+        failopen     Disable proxy interception and restore direct networking
+        running      Return success only when the selected proxy is really listening"
@@ -3036 +3037,19 @@
-start() {
+running() {
+	local server type port
+	server="$(uci -q get shadowsocksr.@global[0].global_server || true)"
+	[ -n "$server" ] && [ "$server" != "nil" ] || return 1
+	type="$(uci -q get "shadowsocksr.$server.type" || true)"
+	case "$type" in
+		v2ray)
+			port="$(uci -q get shadowsocksr.@global[0].default_node_local_port || echo 1234)"
+			pidof xray >/dev/null 2>&1 || return 1
+			busybox netstat -lnt 2>/dev/null | awk -v port="$port" \
+				'$4 ~ (":" port "$") && $6 == "LISTEN" { found=1 } END { exit !found }'
+			;;
+		*)
+			ps_list | grep -E 'ssr-retcp|ss-redir|ssr-redir|ipt2socks|mihomo|tuic-client' | grep -v grep >/dev/null
+			;;
+	esac
+}
+
+start() {
diff --git a/luci-app-ssr-plus/root/etc/uci-defaults/luci-ssr-plus b/luci-app-ssr-plus/root/etc/uci-defaults/luci-ssr-plus
