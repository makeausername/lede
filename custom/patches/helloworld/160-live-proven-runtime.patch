-        uci -q set shadowsocksr.@global_xray_fragment[0].noise='0'
-    fi
+    if ! uci -q get shadowsocksr.@global_xray_fragment[0] > /dev/null; then
+        uci -q add shadowsocksr global_xray_fragment
+    fi
+    uci -q set shadowsocksr.@global_xray_fragment[0].fragment='1'
+    uci -q set shadowsocksr.@global_xray_fragment[0].fragment_packets='tlshello'
+    uci -q set shadowsocksr.@global_xray_fragment[0].fragment_length='100-200'
+    uci -q set shadowsocksr.@global_xray_fragment[0].fragment_delay='10-20'
+    uci -q set shadowsocksr.@global_xray_fragment[0].fragment_maxSplit='100-200'
+    uci -q set shadowsocksr.@global_xray_fragment[0].noise='0'
