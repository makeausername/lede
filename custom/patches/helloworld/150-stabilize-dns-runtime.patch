--- a/luci-app-ssr-plus/root/etc/init.d/shadowsocksr
+++ b/luci-app-ssr-plus/root/etc/init.d/shadowsocksr
@@ -154,6 +154,21 @@ supports_dns2tcp_filter_aaaa() {
 	return 1
 }
 
+wait_for_udp_listener() {
+	local port="$1"
+	local attempt=0
+
+	while [ "$attempt" -lt 5 ]; do
+		if busybox netstat -lnu 2>/dev/null | awk -v port="$port" \
+			'$4 ~ (":" port "$") { found=1 } END { exit !found }'; then
+			return 0
+		fi
+		attempt=$((attempt + 1))
+		sleep 1
+	done
+	return 1
+}
+
 start_dns2tcp() {
 	local dnsserver="$1"
 	local dns2tcp_bin
@@ -172,6 +187,12 @@ start_dns2tcp() {
 	else
 		ln_start_bin "$dns2tcp_bin" dns2tcp -L "127.0.0.1#$dns_port" -R "$filtered_dnsserver"
 	fi
+
+	if ! wait_for_udp_listener "$dns_port"; then
+		echolog "DNS2TCP failed to open the local proxy DNS listener on port $dns_port."
+		return 1
+	fi
+	return 0
 }
 
