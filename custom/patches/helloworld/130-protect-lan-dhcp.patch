+restore_base_dnsmasq_settings() {
+	if [ "$(uci -q get "dhcp.@dnsmasq[0]._unused_ssrp_changed")" = "1" ]; then
+		uci -q del "dhcp.@dnsmasq[0].noresolv"
+		uci -q del_list "dhcp.@dnsmasq[0].server"="127.0.0.1#$china_dns_port"
+		uci -q rename "dhcp.@dnsmasq[0]._orig_noresolv"="noresolv"
+		uci -q rename "dhcp.@dnsmasq[0]._orig_server"="server"
+		uci -q del "dhcp.@dnsmasq[0]._unused_ssrp_changed"
+		uci -q commit dhcp
+	fi
+}
+
+dnsmasq_is_running() {
+	pidof dnsmasq >/dev/null 2>&1
+}
+
+restart_base_dnsmasq() {
+	/etc/init.d/dnsmasq restart >/dev/null 2>&1
+	sleep 2
+	dnsmasq_is_running
+}
+
+enter_fail_open() {
+	local reason="${1:-proxy health check failed}"
+
+	echolog "FAIL-OPEN: ${reason}; removing proxy interception and restoring direct networking."
+	/usr/bin/ssr-rules -f >/dev/null 2>&1 || true
+	ps_list | grep -v grep | grep "$TMP_PATH" | awk '{print $1}' | xargs kill >/dev/null 2>&1
+	restore_base_dnsmasq_settings
+	remove_ssr_dnsmasq_config
+	touch /var/run/ssrplus.fail-open
+	if restart_base_dnsmasq; then
+		echolog "FAIL-OPEN: base dnsmasq and LAN DHCP are running; domestic traffic is direct."
+		return 0
+	fi
+	echolog "ERROR: base dnsmasq failed to restart; LAN DHCP requires attention."
+	return 1
+}
+
+main_proxy_runtime_healthy() {
+	local attempt=0
+
+	[ "$redir_tcp" -gt 0 ] || return 0
+	[ -n "$tcp_config_file" ] || return 1
+	while [ "$attempt" -lt 5 ]; do
+		if ps_list | grep -F "$tcp_config_file" | grep -v grep >/dev/null 2>&1; then
+			return 0
+		fi
+		attempt=$((attempt + 1))
+		sleep 1
+	done
+	return 1
