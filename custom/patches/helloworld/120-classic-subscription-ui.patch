diff --git a/luci-app-ssr-plus/luasrc/model/shadowsocksr/subscription_storage.lua b/luci-app-ssr-plus/luasrc/model/shadowsocksr/subscription_storage.lua
new file mode 100644
index 0000000..bc95a21
--- /dev/null
+++ b/luci-app-ssr-plus/luasrc/model/shadowsocksr/subscription_storage.lua
@@ -0,0 +1,58 @@
+local M = {}
+
+local CONFIG = "shadowsocksr"
+local SECTION_TYPE = "server_subscribe_item"
+
+local function trim(value)
+	if type(value) ~= "string" then
+		return ""
+	end
+	return (value:gsub("^%s*(.-)%s*$", "%1"))
+end
+
+function M.collect_ids(cursor)
+	local ids = {}
+	cursor:foreach(CONFIG, SECTION_TYPE, function(item)
+		ids[#ids + 1] = item[".name"]
+	end)
+	return ids
+end
+
+function M.get(cursor)
+	local selected = ""
+	cursor:foreach(CONFIG, SECTION_TYPE, function(item)
+		if selected == "" and tostring(item.enabled or "1") ~= "0" then
+			selected = trim(item.url)
+		end
+	end)
+	return selected
+end
+
+function M.clear(cursor)
+	for _, sid in ipairs(M.collect_ids(cursor)) do
+		cursor:delete(CONFIG, sid)
+	end
+end
+
+function M.replace(cursor, value)
+	local url = trim(value)
+	if url == "" then
+		M.clear(cursor)
+		return nil
+	end
+
+	local ids = M.collect_ids(cursor)
+	local sid = ids[1] or cursor:add(CONFIG, SECTION_TYPE)
+	cursor:set(CONFIG, sid, "enabled", "1")
+	if not cursor:get(CONFIG, sid, "alias") then
+		cursor:set(CONFIG, sid, "alias", "Subscribe 1")
+	end
+	cursor:set(CONFIG, sid, "url", url)
+
+	for index = 2, #ids do
+		cursor:delete(CONFIG, ids[index])
+	end
+	return sid
+end
+
+return M
