+local function collect_subscribe_item_ids(cursor)
+	local ids = {}
+	cursor:foreach("shadowsocksr", "server_subscribe_item", function(item)
+		ids[#ids + 1] = item[".name"]
+	end)
+	return ids
+end
+
+o = s:option(DynamicList, "_classic_subscribe_urls", translate("Subscribe URL"))
+o.rmempty = true
+function o.cfgvalue(self)
+	local urls = {}
+	self.map.uci:foreach("shadowsocksr", "server_subscribe_item", function(item)
+		local url = trim(item.url or "")
+		if url ~= "" and tostring(item.enabled or "1") ~= "0" then
+			urls[#urls + 1] = url
+		end
+	end)
+	return urls
+end
+function o.write(self, section, values)
+	local cursor = self.map.uci
+	local ids = collect_subscribe_item_ids(cursor)
+	local used = 0
+
+	if type(values) == "string" then
+		values = { values }
+	end
+	for _, value in ipairs(values or {}) do
+		local url = trim(value)
+		if url ~= "" then
+			used = used + 1
+			local sid = ids[used] or cursor:add("shadowsocksr", "server_subscribe_item")
+			cursor:set("shadowsocksr", sid, "enabled", "1")
+			if not cursor:get("shadowsocksr", sid, "alias") then
+				cursor:set("shadowsocksr", sid, "alias", string.format("Subscribe %d", used))
+			end
+			cursor:set("shadowsocksr", sid, "url", url)
+		end
+	end
+	for index = used + 1, #ids do
+		cursor:delete("shadowsocksr", ids[index])
+	end
+end
+function o.remove(self)
+	local cursor = self.map.uci
+	for _, sid in ipairs(collect_subscribe_item_ids(cursor)) do
+		cursor:delete("shadowsocksr", sid)
+	end
+end
+
