diff --git a/luci-app-ssr-plus/luasrc/model/shadowsocksr/subscription_runtime.lua b/luci-app-ssr-plus/luasrc/model/shadowsocksr/subscription_runtime.lua
new file mode 100644
index 0000000..f8cc24c
--- /dev/null
+++ b/luci-app-ssr-plus/luasrc/model/shadowsocksr/subscription_runtime.lua
@@ -0,0 +1,34 @@
+local M = {}
+
+local CONFIG = "shadowsocksr"
+local GLOBAL_TYPE = "global"
+local SERVER_TYPE = "servers"
+
+local function section_exists(cursor, sid)
+	return sid and sid ~= "" and sid ~= "nil" and
+		cursor:get(CONFIG, sid) == SERVER_TYPE
+end
+
+-- Preserve an explicit disabled state after a subscription refresh. Keep an
+-- existing valid manual selection, but never silently choose a replacement.
+-- A missing selected node is disabled so the user can choose again manually.
+function M.ensure_main_server(cursor)
+	local global_sid = cursor:get_first(CONFIG, GLOBAL_TYPE)
+	if not global_sid then
+		return nil, false, "missing-global"
+	end
+
+	local current = cursor:get(CONFIG, global_sid, "global_server") or "nil"
+	if current == "nil" or current == "" then
+		return nil, false, "disabled"
+	end
+
+	if section_exists(cursor, current) then
+		return current, false, "preserved"
+	end
+
+	cursor:set(CONFIG, global_sid, "global_server", "nil")
+	return nil, true, "disabled-missing"
+end
+
+return M
