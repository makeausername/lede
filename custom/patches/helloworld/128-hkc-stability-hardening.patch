+#!/bin/sh
+# Offline validation only: no listener, packets, UCI commit or service restart.
+set -eu
+sid="$(uci -q get shadowsocksr.@global[0].global_server)"
+[ -n "$sid" ] && [ "$sid" != nil ] || exit 0
+[ "$(uci -q get shadowsocksr."$sid".type)" = v2ray ] || exit 0
+[ "$(uci -q get shadowsocksr.@server_subscribe[0].enable_mihomo)" != 1 ] || exit 0
+[ "$(uci -q get shadowsocksr."$sid".v2ray_protocol)" = vless ] || exit 0
+umask 077
+file="/tmp/hkc-xray-preflight-$$.json"
+trap 'rm -f "$file"' EXIT INT TERM
+port="$(uci -q get shadowsocksr."$sid".local_port || echo 1234)"
+/usr/bin/lua /usr/share/shadowsocksr/gen_config.lua "$sid" tcp "$port" 0 >"$file" 2>/dev/null
+/usr/bin/xray run -test -c "$file" >/dev/null 2>&1
+
