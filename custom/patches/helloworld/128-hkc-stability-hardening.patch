diff --git a/luci-app-ssr-plus/root/usr/libexec/hkc-ssr-health b/luci-app-ssr-plus/root/usr/libexec/hkc-ssr-health
new file mode 100755
--- /dev/null
+++ b/luci-app-ssr-plus/root/usr/libexec/hkc-ssr-health
@@ -0,0 +1,85 @@
+#!/bin/sh
+# Supervised independently of SSR. No recovery while SSR is intentionally stopped.
+umask 077
+uptime_s() { cut -d. -f1 /proc/uptime; }
+wan_ready() {
+    [ "$(ifstatus wan 2>/dev/null | jsonfilter -e '@.up')" = true ] &&
+    ip -4 route show default | grep -q '^default '
+}
+clock_check() {
+    local now saved=0
+    if curl -4 -fsS --connect-timeout 3 --max-time 6 -o /dev/null https://www.baidu.com 2>/dev/null ||
+       curl -4 -fsS --connect-timeout 3 --max-time 6 -o /dev/null https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null; then
+        date +%s >/var/run/hkc-time-valid
+        now="$(date +%s)"
+        [ ! -s /etc/hkc-last-good-time ] || read -r saved </etc/hkc-last-good-time
+        case "$saved" in ''|*[!0-9]*) saved=0 ;; esac
+        if [ $((now - saved)) -ge 21600 ]; then
+            echo "$now" >/etc/hkc-last-good-time.new && mv /etc/hkc-last-good-time.new /etc/hkc-last-good-time
+        fi
+        return 0
+    fi
+    rm -f /var/run/hkc-time-valid
+    logger -t hkc-stability "HTTPS/time health check failed; updates retain old data, node switching paused"
+    return 1
+}
+local_health() {
+    local sid
+    sid="$(uci -q get shadowsocksr.@global[0].global_server)"
+    [ -n "$sid" ] && [ "$sid" != nil ] || return 0
+    [ "$(uci -q get shadowsocksr."$sid".type)" = v2ray ] || return 0
+    [ "$(uci -q get shadowsocksr.@server_subscribe[0].enable_mihomo)" != 1 ] || return 0
+    pidof v2ray >/dev/null || return 1
+    if [ "$(uci -q get shadowsocksr.@global[0].monitor_enable)" = 1 ]; then
+        pidof ssr-monitor >/dev/null || return 1
+    fi
+    if [ "$(uci -q get shadowsocksr.@global[0].enable_switch)" = 1 ]; then
+        pidof ssr-switch >/dev/null || return 1
+    fi
+    iptables -t nat -S SS_SPEC_WAN_FW >/dev/null 2>&1 || return 1
+    iptables -t nat -S PREROUTING 2>/dev/null | grep -q -- '-j SS_SPEC_WAN_AC' || return 1
+    timeout 5 nslookup www.baidu.com 127.0.0.1 >/dev/null 2>&1 || return 1
+}
+repair() {
+    local now last=0
+    now="$(uptime_s)"
+    [ ! -f /var/run/hkc-ssr-repair.last ] || read -r last </var/run/hkc-ssr-repair.last
+    case "$last" in ''|*[!0-9]*) last=0 ;; esac
+    [ "$last" -eq 0 ] || [ $((now - last)) -ge 180 ] || return 0
+    /usr/libexec/hkc-ssr-preflight || { logger -t hkc-stability "repair refused: invalid core configuration"; return 1; }
+    echo "$now" >/var/run/hkc-ssr-repair.last
+    logger -t hkc-stability "repeated local health failure with WAN ready; repairing SSR"
+    /etc/init.d/shadowsocksr recover >/dev/null 2>&1
+}
+case "$1" in
+    check) wan_ready && local_health; exit $? ;;
+    time) clock_check; exit $? ;;
+esac
+failures=0
+ticks=0
+sleep 20
+while :; do
+    if wan_ready; then
+        if [ "$ticks" -eq 0 ]; then clock_check || true; fi
+        # Retry existing NTP service when its synchronization hook has not fired.
+        if [ "$ticks" -eq 0 ] && [ ! -f /var/run/hkc-ntp-synced ]; then
+            /etc/init.d/sysntpd restart >/dev/null 2>&1
+        fi
+        if [ -f /var/run/hkc-ssr-intent ]; then
+            if local_health; then
+                failures=0
+                rm -f /var/run/hkc-wan-event
+            else
+                failures=$((failures + 1))
+                if [ "$failures" -ge 3 ]; then repair; failures=0; fi
+            fi
+        else
+            failures=0
+        fi
+    else
+        failures=0
+    fi
+    ticks=$(((ticks + 1) % 20))
+    sleep 30
+done
+
