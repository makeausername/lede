+local M = {}
+local fs = require "nixio.fs"
+local nixio = require "nixio"
+local sys = require "luci.sys"
+local function quote(s) return "'" .. tostring(s):gsub("'", "'\\''") .. "'" end
+function M.lock(name)
+    local f = nixio.open("/var/lock/hkc-" .. name .. ".lock", "w", 600)
+    if not f then return nil end
+    if not f:lock("tlock") then f:close(); return nil end
+    return f
+end
+function M.download(url, path, ua)
+    if type(url) ~= "string" or not url:match("^https?://") or url:find("[%z\r\n]") then return false end
+    os.remove(path)
+    local cmd = "umask 077; curl -4 -fsSL --http1.1 --connect-timeout 5 --max-time 45 --retry 1 --retry-max-time 50 --max-filesize 8388608 --proto '=http,https' --proto-redir '=http,https' -H 'Accept-Encoding: identity' "
+    if ua and ua ~= "" then cmd = cmd .. " -A " .. quote(ua) end
+    local ok = sys.call(cmd .. " -o " .. quote(path) .. " -- " .. quote(url) .. " 2>/dev/null") == 0
+    local size = fs.stat(path, "size") or 0
+    if not ok or size == 0 or size > 8388608 then os.remove(path); return false end
+    return true
+end
+function M.atomic_write(path, data)
+    local tmp = path .. ".hkc-new"
+    local f = nixio.open(tmp, "w", 600)
+    if not f then return false end
+    local offset, ok = 1, true
+    while offset <= #data do
+        local n = f:write(data:sub(offset))
+        if not n or n == 0 then ok = false; break end
+        offset = offset + n
+    end
+    if ok and not f:sync() then ok = false end
+    f:close()
+    if not ok then os.remove(tmp); return false end
+    if not os.rename(tmp, path) then os.remove(tmp); return false end
+    return true
+end
+function M.fingerprint(t)
+    if type(t) ~= "table" then return tostring(t) end
+    local keys, out = {}, {}
+    for k in pairs(t) do
+        if tostring(k):sub(1,1) ~= "." and k ~= "alias" and k ~= "hashkey" and
+           k ~= "grouphashkey" and k ~= "switch_enable" then keys[#keys+1] = k end
+    end
+    table.sort(keys, function(a,b) return tostring(a)<tostring(b) end)
+    for _,k in ipairs(keys) do out[#out+1] = tostring(k) .. "=" .. M.fingerprint(t[k]) end
+    return table.concat(out,"\n")
+end
+function M.is_error_document(path)
+    return M.error_text(fs.readfile(path) or "")
+end
+function M.error_text(text)
+    local s = text:lower()
+    return s == "" or s:find("<!doctype",1,true) or s:find("<html",1,true) or
+        s:find("<body",1,true) or s:match('^%s*{%s*"') ~= nil
+end
+local function ipv4(s)
+    local a,b,c,d = s:match("^(%d+)%.(%d+)%.(%d+)%.(%d+)$")
+    if not a then return false end
+    for _,n in ipairs({a,b,c,d}) do if tonumber(n)>255 then return false end end
+    return true
+end
+function M.valid_rules(path, kind)
+    if M.is_error_document(path) then return false end
+    local count = 0
+    for line in io.lines(path) do
+        line = line:gsub("\r","")
+        if line ~= "" and not line:match("^%s*#") then
+            count = count+1
+            if kind == "ip_data" then
+                local ip,bits = line:match("^([%d.]+)/(%d+)$")
+                if not ip or not ipv4(ip) or tonumber(bits)>32 then return false end
+            else
+                if not line:match("^server=/[%w._%-]+/[%w.:#%-]+$") and
+                   not line:match("^ipset=/[%w._%-]+/[%w_%-]+$") and
+                   not line:match("^address=/[%w._%-]+/[%d.:]*$") then return false end
+            end
+        end
+    end
+    -- Refuse tiny/truncated public lists; manual custom rules use separate files.
+    if count < 10 then return false end
+    if kind ~= "ip_data" then
+        if sys.call("dnsmasq --test --conf-file=" .. quote(path) .. " >/dev/null 2>&1") ~= 0 then return false end
+    end
+    return true
+end
+function M.install_rules(source, dst, runtime)
+    local data = fs.readfile(source)
+    if not data then return false end
+    local old = fs.readfile(dst)
+    if old then
+        local _,old_lines = old:gsub("\n","")
+        local _,new_lines = data:gsub("\n","")
+        if old_lines > 40 and new_lines < old_lines / 4 then return false end
+    end
+    if not M.atomic_write(dst, data) then return false end
+    if runtime and not M.atomic_write(runtime, data) then
+        if old then M.atomic_write(dst, old) else os.remove(dst) end
+        return false
+    end
+    return true
+end
+return M
+
