#!/bin/sh

# Only replace the landing document. LuCI remains available at /cgi-bin/luci/admin
# as a recovery and maintenance path if the simplified UI is unavailable.
cat > /www/index.html <<'EOF'
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta http-equiv="refresh" content="0;url=/cgi-bin/luci/hkc-connect">
  <title>HKC Connect</title>
</head>
<body>
  <p><a href="/cgi-bin/luci/hkc-connect">Open HKC Connect</a></p>
</body>
</html>
EOF

chmod 0644 /www/index.html
rm -f /tmp/luci-indexcache /tmp/luci-modulecache/* 2>/dev/null

exit 0
