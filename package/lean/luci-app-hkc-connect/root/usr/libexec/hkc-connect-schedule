#!/bin/sh

set -eu

CRON_FILE='/etc/crontabs/root'
enabled="$(uci -q get hkc_connect.main.auto_update 2>/dev/null || echo 1)"
hour="$(uci -q get hkc_connect.main.update_hour 2>/dev/null || echo 5)"
minute="$(uci -q get hkc_connect.main.update_minute 2>/dev/null || echo 0)"

case "$hour" in
	''|*[!0-9]*) hour=5 ;;
esac
case "$minute" in
	''|*[!0-9]*) minute=0 ;;
esac
[ "$hour" -ge 0 ] 2>/dev/null && [ "$hour" -le 23 ] 2>/dev/null || hour=5
[ "$minute" -ge 0 ] 2>/dev/null && [ "$minute" -le 59 ] 2>/dev/null || minute=0

mkdir -p /etc/crontabs
touch "$CRON_FILE"
sed -i '\#/usr/share/shadowsocksr/ssrplusupdate.sh#d' "$CRON_FILE"

if [ "$enabled" = '1' ]; then
	printf '%s %s * * * /usr/share/shadowsocksr/ssrplusupdate.sh >/var/log/ssrplus.log 2>&1 # HKC subscription update\n' \
		"$minute" "$hour" >> "$CRON_FILE"
fi

crontab "$CRON_FILE"
exit 0
