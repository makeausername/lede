  * Look for /etc/config/fstab on all supported partitions and use it for
  * mounting extroot if specified.
  */
+/* Only the dedicated migration board must avoid the vendor configuration. */
+static int hkc_stock_extroot(void)
+{
+	char compatible[128] = { 0 };
+	FILE *f = fopen("/proc/device-tree/compatible", "rb");
+	if (!f)
+		return 0;
+	fread(compatible, 1, sizeof(compatible) - 1, f);
+	fclose(f);
+	return !strcmp(compatible, "netcore,n60-pro-stock-slot1");
+}
