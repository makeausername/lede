+static int hkc_stock_slot1(void)
+{
+	char compatible[128] = { 0 };
+	FILE *f = fopen("/proc/device-tree/compatible", "rb");
+	if (!f)
+		return 0;
+	fread(compatible, 1, sizeof(compatible) - 1, f);
+	fclose(f);
+	return !strcmp(compatible, "netcore,n60-pro-stock-slot1");
+}
